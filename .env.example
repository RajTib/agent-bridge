# AgentBridge configuration. Copy to .env (or run `npm run setup`) and fill in.
# .env is git-ignored. Never commit real credentials.

# --- Server ------------------------------------------------------------------
AGENTBRIDGE_HOST=127.0.0.1
AGENTBRIDGE_PORT=4317
# Where the SQLite database and generated secrets live (default: ~/.agentbridge)
# AGENTBRIDGE_DATA_DIR=
# Dashboard login password (min 12 chars). If unset, one is generated into
# <data dir>/dashboard-password on first start.
AGENTBRIDGE_DASHBOARD_PASSWORD=
# Shared secret between the Claude Code hook and the server. Leave unset to have
# the server generate <data dir>/hook-token, which the hook reads automatically.
# AGENTBRIDGE_HOOK_TOKEN=
# Public HTTPS URL that reaches this server (e.g. a cloudflared/ngrok tunnel).
# Required for real phone calls: the provider POSTs keypad presses here.
AGENTBRIDGE_PUBLIC_URL=
# Set to true only when running behind a reverse proxy you control.
AGENTBRIDGE_TRUST_PROXY=false
AGENTBRIDGE_LOG_LEVEL=info

# --- Approvals ---------------------------------------------------------------
# How long a request waits for a human decision (15-3600s).
APPROVAL_TIMEOUT_SECONDS=300
# When nobody decides in time:  ask = hand back to Claude Code's normal prompt
#                               deny = tell Claude Code the action was denied
# Neither ever approves.
APPROVAL_TIMEOUT_BEHAVIOR=ask

# --- Telephony ---------------------------------------------------------------
# none | mock | twilio     (mock = simulated calls, no real phone call is placed)
TELEPHONY_PROVIDER=mock
# Your phone, E.164 format (+91 for India).
PHONE_TO_NUMBER=
# Comma-separated allow-list. Calls are only ever placed to / accepted from these.
# Defaults to PHONE_TO_NUMBER.
TRUSTED_PHONE_NUMBERS=
# Only phone for requests at or above this risk (low | medium | high).
CALL_MIN_RISK=low
CALL_RING_TIMEOUT_SECONDS=30
CALL_MAX_ATTEMPTS=2
CALL_RETRY_DELAY_SECONDS=30
DTMF_MAX_PROMPTS=3
DTMF_INPUT_TIMEOUT_SECONDS=8
# Twilio <Say> voice + language. Polly.Aditi / en-IN suits Indian English.
TTS_VOICE=Polly.Aditi
TTS_LANGUAGE=en-IN

# --- Twilio (TELEPHONY_PROVIDER=twilio) --------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio voice number you own. Calls to India must use a non-Indian caller ID.
TWILIO_FROM_NUMBER=

# --- Discord (optional, notifications only) ----------------------------------
DISCORD_WEBHOOK_URL=
# Comma-separated subset of: session_started, task_completed, approval_required,
# call_initiated, decision_received, task_failed, agent_disconnected (default: all)
DISCORD_EVENTS=
